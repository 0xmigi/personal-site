---
interface Props {
  section?: string;
}

const { section } = Astro.props;
---

<p class="text-[14px] leading-relaxed">
  {section ? (
    <a href="/" class="text-neutral-500 no-underline hover:text-neutral-900 transition-colors">Azuolas Compy</a>
  ) : (
    <span class="font-medium">Azuolas Compy</span>
  )}{section && <Fragment><span class="text-neutral-500"> / </span><span class="font-medium text-neutral-900">{section}</span></Fragment>}
</p>
