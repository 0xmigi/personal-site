---
interface Props {
  section?: string;
}

const { section } = Astro.props;
---

<p class="text-[17px] leading-relaxed">
  {section ? (
    <a href="/" class="font-medium text-neutral-900 no-underline hover:text-neutral-600 transition-colors">Azuolas</a>
  ) : (
    <span class="font-medium">Azuolas</span>
  )}{section && <span class="text-neutral-500"> / {section}</span>}
</p>
