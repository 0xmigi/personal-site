---
import { yearOf } from '../lib/date';

export interface TimelineItem {
  title: string;
  href: string;
  date: string;
  tag?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;

const sorted = [...items].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
);

const weekOf = (d: Date) => Math.min(3, Math.floor((d.getUTCDate() - 1) / 7));

type Item = TimelineItem & { cell: string };
type Row = { year: number; items: Item[]; filled: Set<string> };

const groups: Row[] = [];
for (const it of sorted) {
  const y = yearOf(it.date);
  let g = groups.find((x) => x.year === y);
  if (!g) {
    g = { year: y, items: [], filled: new Set() };
    groups.push(g);
  }
  const d = new Date(it.date);
  const m = d.getUTCMonth();
  const w = weekOf(d);
  g.filled.add(`${m}-${w}`);
  g.items.push({ ...it, cell: `${y}-${m}-${w}` });
}

const yearsData = groups.map((g) => ({
  year: g.year,
  filled: [...g.filled],
  items: g.items.slice(0, 4).map((it) => ({ title: it.title, href: it.href, tag: it.tag ?? '', cell: it.cell })),
}));

const WINDOW = Math.min(3, yearsData.length);
const initial = yearsData.slice(0, WINDOW);

// 12 months (rows, December at top) x 4 weeks (cols)
const cells = Array.from({ length: 12 }, (_, i) => {
  const m = 11 - i;
  return Array.from({ length: 4 }, (_, w) => ({ m, w }));
}).flat();

const linkClass =
  'text-neutral-900 underline decoration-transparent hover:decoration-neutral-300 underline-offset-[3px] transition-colors';
const titleClass = `min-w-0 flex-1 truncate ${linkClass}`;
const dotsWrap = 'ml-3 mr-4 grid shrink-0 grid-cols-[repeat(4,4px)] items-center gap-x-[5px]';
const ctlClass = 'text-[14px] italic text-neutral-400 transition-colors hover:text-neutral-900';
---

<div class="text-[14px]">
  {/* newer (top) — aligned to the title column */}
  <div class="mb-2 flex justify-end pr-2" data-tl-newer-wrap style="visibility: hidden;">
    <button type="button" data-tl-newer class={ctlClass}>newer</button>
  </div>

  <div class="ml-auto h-px w-1/4 bg-neutral-200"></div>

  <div id="tl-modules" class="space-y-5 py-3">
    {initial.map((d, i) => (
      <div class="flex items-start" data-slot={i}>
        <a
          data-year
          href={`/${d.year}`}
          class="w-9 shrink-0 pt-px text-[14px] tabular-nums text-neutral-400 transition-colors hover:text-neutral-900"
        >
          {d.year}
        </a>

        <div
          data-dots
          class={dotsWrap}
          style="height: 114px; grid-template-rows: repeat(12, 1fr);"
        >
          {cells.map(({ m, w }) => (
            <span
              class:list={['dot', d.filled.includes(`${m}-${w}`) && 'dot-filled']}
              data-tl-dot={`${d.year}-${m}-${w}`}
            />
          ))}
        </div>

        <ul data-titles class="min-w-0 flex-1 space-y-2.5">
          {d.items.map((it) => (
            <li class="flex items-baseline gap-3">
              <a href={it.href} class={titleClass} data-tl-link={it.cell}>{it.title}</a>
              {it.tag && <span class="shrink-0 text-[14px] text-neutral-400">{it.tag}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="ml-auto h-px w-1/4 bg-neutral-200"></div>

  {/* older (bottom) — aligned to the title column */}
  <div class="mt-2 flex justify-end pr-2" data-tl-older-wrap>
    <button type="button" data-tl-older class={ctlClass}>older</button>
  </div>
</div>

<script type="application/json" id="tl-data" is:inline set:html={JSON.stringify(yearsData)}></script>

<style is:global>
  .dot {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: #e5e5e5;
    transition: transform 0.12s ease, background-color 0.12s ease;
  }
  .dot-filled {
    background: #404040;
  }
  .dot-active {
    transform: scale(2.2);
    background: #171717;
  }
</style>

<script>
  const LINK_CLASS =
    'min-w-0 flex-1 truncate text-neutral-900 underline decoration-transparent hover:decoration-neutral-300 underline-offset-[3px] transition-colors';

  const dataEl = document.getElementById('tl-data');
  const modules = document.getElementById('tl-modules');
  if (dataEl && modules) {
    const years = JSON.parse(dataEl.textContent || '[]');
    const rows = [...modules.querySelectorAll('[data-slot]')];
    const olderBtn = document.querySelector('[data-tl-older]');
    const newerBtn = document.querySelector('[data-tl-newer]');
    const olderWrap = document.querySelector('[data-tl-older-wrap]');
    const newerWrap = document.querySelector('[data-tl-newer-wrap]');
    const win = rows.length;
    const maxStart = Math.max(0, years.length - win);
    let start = 0;

    const CELLS = [];
    for (let i = 0; i < 12; i++) {
      const m = 11 - i;
      for (let w = 0; w < 4; w++) CELLS.push(m + '-' + w);
    }

    const dotsHTML = (d) =>
      CELLS.map(
        (c) => `<span class="dot${d.filled.includes(c) ? ' dot-filled' : ''}" data-tl-dot="${d.year}-${c}"></span>`,
      ).join('');

    const titlesHTML = (d) =>
      d.items
        .map(
          (it) =>
            `<li class="flex items-baseline gap-3"><a href="${it.href}" class="${LINK_CLASS}" data-tl-link="${it.cell}">${it.title}</a>${it.tag ? `<span class="shrink-0 text-[14px] text-neutral-400">${it.tag}</span>` : ''}</li>`,
        )
        .join('');

    function paint() {
      rows.forEach((row, i) => {
        const d = years[start + i];
        if (!d) return;
        row.querySelector('[data-dots]').innerHTML = dotsHTML(d);
        row.querySelector('[data-titles]').innerHTML = titlesHTML(d);
        const y = row.querySelector('[data-year]');
        y.setAttribute('href', '/' + d.year);
        y.textContent = String(d.year);
      });
      newerWrap.style.visibility = start <= 0 ? 'hidden' : 'visible';
      olderWrap.style.visibility = start >= maxStart ? 'hidden' : 'visible';
    }

    olderBtn?.addEventListener('click', () => {
      if (start < maxStart) {
        start++;
        paint();
      }
    });
    newerBtn?.addEventListener('click', () => {
      if (start > 0) {
        start--;
        paint();
      }
    });

    // hover a title -> light its dot (delegated so it survives re-renders)
    modules.addEventListener('mouseover', (e) => {
      const link = e.target.closest('[data-tl-link]');
      if (!link) return;
      document.querySelector(`[data-tl-dot="${link.dataset.tlLink}"]`)?.classList.add('dot-active');
    });
    modules.addEventListener('mouseout', (e) => {
      const link = e.target.closest('[data-tl-link]');
      if (!link) return;
      document.querySelector(`[data-tl-dot="${link.dataset.tlLink}"]`)?.classList.remove('dot-active');
    });

    // initial control visibility (server rendered start = 0)
    newerWrap.style.visibility = 'hidden';
    olderWrap.style.visibility = maxStart > 0 ? 'visible' : 'hidden';
  }
</script>
