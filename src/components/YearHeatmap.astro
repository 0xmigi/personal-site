---
interface Props {
  year: number;
  dates: string[]; // YYYY-MM-DD strings that should be lit
  height?: number; // total pixel height — matches the home page bio-top → 2024-bottom rectangle
}

const { year, dates, height = 512 } = Astro.props;
const filled = new Set(dates);

const jan1DOW = new Date(Date.UTC(year, 0, 1)).getUTCDay(); // 0=Sun
const isLeap = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
const daysInYear = isLeap ? 366 : 365;

const pad = (n: number) => String(n).padStart(2, '0');

type Cell = { iso: string; filled: boolean } | null;

let maxRow = 0;
const days: { row: number; col: number; iso: string; filled: boolean }[] = [];
for (let i = 0; i < daysInYear; i++) {
  const d = new Date(Date.UTC(year, 0, 1 + i));
  const col = d.getUTCDay();
  const row = Math.floor((i + jan1DOW) / 7);
  if (row > maxRow) maxRow = row;
  const iso = `${year}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
  days.push({ row, col, iso, filled: filled.has(iso) });
}

// newest week at the top
const grid: Cell[][] = Array.from({ length: maxRow + 1 }, () => Array<Cell>(7).fill(null));
for (const d of days) {
  grid[maxRow - d.row][d.col] = { iso: d.iso, filled: d.filled };
}
const flat = grid.flat();
const numRows = maxRow + 1;
---

{/* mirrors the home timeline dots: 4px round, same greys, rows spread over a fixed height */}
<div
  class="grid items-center gap-x-[5px]"
  style={`height: ${height}px; grid-template-columns: repeat(7, 4px); grid-template-rows: repeat(${numRows}, 1fr);`}
>
  {flat.map((cell) =>
    cell ? (
      <span class:list={['ydot', cell.filled && 'ydot-on']} title={cell.iso} />
    ) : (
      <span class="block h-1 w-1" />
    ),
  )}
</div>

<style>
  .ydot {
    position: relative;
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: #e5e5e5;
  }
  .ydot-on {
    background: #404040;
  }
</style>

{/* global: the ring is injected client-side, so scoped styles wouldn't reach it */}
<style is:global>
  .now-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 14px;
    transform: translate(-50%, -50%) rotate(-6deg);
    pointer-events: none;
  }
  .now-ring path {
    fill: none;
    stroke: #f97316;
    stroke-width: 3.5;
    stroke-linecap: round;
  }
</style>

<script>
  // hand-drawn ring on today's dot — computed in the browser so the static
  // page never needs a rebuild; no-op on past years' pages
  const pad = (n: number) => String(n).padStart(2, '0');
  const t = new Date();
  const iso = `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`;
  document
    .querySelector(`.ydot[title="${iso}"]`)
    ?.insertAdjacentHTML(
      'beforeend',
      '<svg class="now-ring" viewBox="0 0 40 32" aria-hidden="true"><path d="M20.2 3.1C30.5 1.8 37.8 8.2 37.2 16.1 36.6 24.6 28.4 29.6 19.1 29.2 10.2 28.8 2.6 24 2.9 15.6 3.2 7.4 11.5 3.9 22.8 4.4"/></svg>',
    );
</script>
