---
interface Props {
  year: number;
  activity: Record<string, number>; // YYYY-MM-DD -> commit count that day
  baseline?: string[]; // YYYY-MM-DD weekdays inside a work span — faint grey floor
  height?: number; // total pixel height — matches the home page bio-top → 2024-bottom rectangle
}

const { year, activity, baseline = [], height = 512 } = Astro.props;
const worked = new Set(baseline);

// commits that day -> 0–4 grey heat level (GitHub-style); a worked weekday with
// no commits still gets the faintest level so employment reads as a floor
const dayLevel = (n: number) => (n === 0 ? 0 : n <= 2 ? 1 : n <= 5 ? 2 : n <= 9 ? 3 : 4);
const levelFor = (iso: string) => Math.max(dayLevel(activity[iso] ?? 0), worked.has(iso) ? 1 : 0);

const jan1DOW = new Date(Date.UTC(year, 0, 1)).getUTCDay(); // 0=Sun
const isLeap = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
const daysInYear = isLeap ? 366 : 365;

const pad = (n: number) => String(n).padStart(2, '0');

type Cell = { iso: string; level: number } | null;

let maxRow = 0;
const days: { row: number; col: number; iso: string; level: number }[] = [];
for (let i = 0; i < daysInYear; i++) {
  const d = new Date(Date.UTC(year, 0, 1 + i));
  const col = d.getUTCDay();
  const row = Math.floor((i + jan1DOW) / 7);
  if (row > maxRow) maxRow = row;
  const iso = `${year}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
  days.push({ row, col, iso, level: levelFor(iso) });
}

// newest week at the top
const grid: Cell[][] = Array.from({ length: maxRow + 1 }, () => Array<Cell>(7).fill(null));
for (const d of days) {
  grid[maxRow - d.row][d.col] = { iso: d.iso, level: d.level };
}
const flat = grid.flat();
const numRows = maxRow + 1;
---

{/* mirrors the home timeline dots: 4px round, same greys, rows spread over a fixed height */}
<div
  class="grid items-center gap-x-[5px]"
  style={`height: ${height}px; grid-template-columns: repeat(7, 4px); grid-template-rows: repeat(${numRows}, 1fr);`}
>
  {flat.map((cell) =>
    cell ? (
      <span class:list={['ydot', cell.level && `ydot-lv${cell.level}`]} title={cell.iso} />
    ) : (
      <span class="block h-1 w-1" />
    ),
  )}
</div>

<style>
  .ydot {
    position: relative;
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: #e5e5e5;
  }
  /* always-on coding activity: grey deepens with commits that day */
  .ydot-lv1 {
    background: #c2c2c2;
  }
  .ydot-lv2 {
    background: #949494;
  }
  .ydot-lv3 {
    background: #666666;
  }
  .ydot-lv4 {
    background: #404040;
  }
  /* desktop hover: this project's commits in orange, on top of the grey */
  .ydot-heat-1 {
    background: #fdba74;
    transform: scale(1.6);
    z-index: 1;
  }
  .ydot-heat-2 {
    background: #fb923c;
    transform: scale(1.9);
    z-index: 1;
  }
  .ydot-heat-3 {
    background: #ea580c;
    transform: scale(2.2);
    z-index: 1;
  }
</style>
