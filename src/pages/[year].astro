---
import Page from '../layouts/Page.astro';
import Header from '../components/Header.astro';
import YearHeatmap from '../components/YearHeatmap.astro';
import { getItems, getCommitActivity, getWorkSpans, byYearPinDate } from '../lib/content';
import { fmtMonthDay, yearOf, eachWeekday } from '../lib/date';

export async function getStaticPaths() {
  const years = [...new Set(getItems().map((it) => yearOf(it.date)))];
  return years.map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props as { year: number };

const items = getItems()
  .filter((it) => yearOf(it.date) === year)
  .sort(byYearPinDate);

// this year's slice of the commit activity — the grey heat behind the calendar
const activity = Object.fromEntries(
  Object.entries(getCommitActivity()).filter(([iso]) => iso.startsWith(`${year}-`)),
);

// weekdays this year that fall inside an employment span — the faint floor
const baseline: string[] = [];
for (const s of getWorkSpans()) {
  eachWeekday(s.start, s.end, (iso, y) => {
    if (y === year) baseline.push(iso);
  });
}

// per-work-role weekdays this year, so hovering a role can light its own span
const workDaysByHref: Record<string, string[]> = {};
for (const it of items) {
  if (it.type !== 'work' || !it.start) continue;
  const days: string[] = [];
  eachWeekday(it.start, it.date, (iso, y) => {
    if (y === year) days.push(iso);
  });
  if (days.length) workDaysByHref[it.href] = days;
}

const linkClass =
  'text-neutral-900 underline decoration-transparent hover:decoration-neutral-300 underline-offset-[3px] transition-colors';
---

<Page title={`${year} — Azuolas`} description={`Everything from ${year}.`}>
  <Header section={String(year)} />

  <div class="mt-4 flex items-start gap-6 py-3">
    <YearHeatmap year={year} activity={activity} baseline={baseline} />

    <ul class="grid min-w-0 flex-1 grid-cols-[minmax(0,1fr)_auto_auto] gap-x-2.5 gap-y-2.5 text-[14px]">
      {items.map((it) => (
        <li
          class="col-span-3 grid grid-cols-subgrid items-baseline"
          data-commits={it.commits ? JSON.stringify(it.commits) : undefined}
          data-workdays={workDaysByHref[it.href] ? JSON.stringify(workDaysByHref[it.href]) : undefined}
        >
          {/* one row per entry: title | tag | date. the list is one grid and each
             row a subgrid, so the tag and date columns share widths across the
             whole page and line up; a long title wraps under itself (the
             column is too narrow to truncate gracefully) */}
          <a href={it.href} class={`min-w-0 ${linkClass}`}>{it.title}</a>
          <span class="text-neutral-400">{it.tag}</span>
          <time class="text-right tabular-nums text-neutral-400">{fmtMonthDay(it.date)}</time>
        </li>
      ))}
    </ul>
  </div>
</Page>

<script>
  // hovering an entry lights its own days orange (the day-level version of the
  // home timeline's heat): a project by commit count (graduated), a work role
  // across every weekday it covered (flat mid-orange)
  const heatLevel = (n: number) => (n >= 5 ? 3 : n >= 3 ? 2 : 1);
  let lit: Element[] = [];
  const clear = () => {
    lit.forEach((el) => el.classList.remove('ydot-heat-1', 'ydot-heat-2', 'ydot-heat-3'));
    lit = [];
  };
  const light = (iso: string, lv: number) => {
    const dot = document.querySelector(`.ydot[title="${iso}"]`);
    if (dot) {
      dot.classList.add(`ydot-heat-${lv}`);
      lit.push(dot);
    }
  };
  for (const row of document.querySelectorAll<HTMLElement>('[data-commits],[data-workdays]')) {
    const commits = row.dataset.commits
      ? (JSON.parse(row.dataset.commits) as Record<string, number>)
      : null;
    const workdays = row.dataset.workdays ? (JSON.parse(row.dataset.workdays) as string[]) : null;
    row.addEventListener('mouseenter', () => {
      clear();
      if (commits) for (const [iso, n] of Object.entries(commits)) light(iso, heatLevel(n));
      else if (workdays) for (const iso of workdays) light(iso, 2);
    });
    row.addEventListener('mouseleave', clear);
  }
</script>
