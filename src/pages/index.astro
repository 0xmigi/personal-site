---
import Page from '../layouts/Page.astro';
import Header from '../components/Header.astro';
import Timeline from '../components/Timeline.astro';
import { getItems } from '../lib/content';

const items = getItems();

const linkClass =
  'text-neutral-900 underline decoration-neutral-300 decoration-1 underline-offset-[3px] hover:decoration-neutral-900 transition-colors';
---

<Page title="Azuolas" description="Engineer and founder.">
  <Header />

  <p class="mt-4 text-[14px] leading-relaxed text-neutral-800">
    Engineer and founder building <a href="https://x.com/0xmigi" target="_blank" rel="noopener noreferrer" class={linkClass}>Moment</a>. Previously full-stack across crypto, AI, and consumer. Based in NYC.
    You can find me on <a href="https://x.com/0xmigi" target="_blank" rel="noopener noreferrer" class={linkClass}>X</a> and <a href="https://github.com/0xmigi" target="_blank" rel="noopener noreferrer" class={linkClass}>GitHub</a>.
  </p>

  <section class="mt-8">
    <Timeline items={items} />
  </section>
</Page>
