---
import Page from '../layouts/Page.astro';
import Header from '../components/Header.astro';

const videos = [
  {
    title: 'Moment — intro',
    src: '/moment-intro.mp4',
    date: '2026-03-01',
    poster: '/moment-intro.jpg' as string | undefined,
  },
];

const fmtDay = (iso: string) => {
  const d = new Date(iso);
  return `${String(d.getUTCDate()).padStart(2, '0')}/${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
};
---

<Page title="Azuolas / videos" description="Videos.">
  <Header section="videos" />

  <section class="mt-10">
    <ul class="space-y-1">
      {videos.map((v, i) => {
        const d = new Date(v.date);
        return (
          <li class="flex items-baseline gap-6 text-[15px]">
            <span class="text-neutral-400 tabular-nums w-12 shrink-0">
              {i === 0 ? d.getUTCFullYear() : ''}
            </span>
            <span class="flex-1 text-neutral-900">{v.title}</span>
            <span class="text-neutral-400 tabular-nums shrink-0">{fmtDay(v.date)}</span>
          </li>
        );
      })}
    </ul>
  </section>

  {videos[0] && (
    <div class="mt-12">
      <video
        class="w-full rounded-md border border-neutral-200 bg-neutral-50"
        controls
        preload="metadata"
        playsinline
        poster={videos[0].poster}
      >
        <source src={videos[0].src} type="video/mp4" />
        Your browser doesn't support video playback.
      </video>
    </div>
  )}
</Page>
