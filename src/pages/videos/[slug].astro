---
import Page from '../../layouts/Page.astro';
import Back from '../../components/Back.astro';
import { fmtDate } from '../../lib/date';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../videos/*.mdx', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.mdx$/, '') },
    props: { mod },
  }));
}

const { mod } = Astro.props as { mod: any };
const fm = mod.frontmatter;
const Content = mod.Content;
---

<Page title={`Azuolas / ${fm.title}`} description={fm.title}>
  <Back />

  <article class="mt-8">
    <h1 class="text-[19px] font-medium tracking-tight">{fm.title}</h1>
    <p class="mt-1 text-sm text-neutral-500">{fmtDate(fm.date)}</p>

    <video
      class="mt-6 w-full rounded-md bg-neutral-50"
      controls
      preload="metadata"
      playsinline
      poster={fm.poster}
    >
      <source src={fm.src} type="video/mp4" />
      Your browser doesn't support video playback.
    </video>

    <div
      class="mt-8 prose prose-neutral max-w-none
             prose-p:text-[17px] prose-p:leading-relaxed
             prose-a:text-neutral-900 prose-a:decoration-neutral-300 prose-a:decoration-1 prose-a:underline-offset-[3px] hover:prose-a:decoration-neutral-900"
    >
      <Content />
    </div>
  </article>
</Page>
